# DISCORD BOT CONFIGURATION
TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id
OWNER_ID=your-discord-user-id

# DOCKER POSTGRES CONFIGURATION (Used by docker-compose to create the database)
POSTGRES_DB=thhv_bot_db
POSTGRES_USER=thhv_bot_user
POSTGRES_PASSWORD=change_this_password

# LOCAL DEVELOPMENT URLS (Required for running 'npx prisma studio' or bot locally outside Docker)
# Note: Keep host as 'localhost' here so local CLI tools can connect.
# When running inside Docker, compose.yml automatically overrides this.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Optional: Local Redis connection (if you run the bot locally)
REDIS_URL="redis://localhost:6379"